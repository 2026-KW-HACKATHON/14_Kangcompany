# 복사해서 .env.local 로 저장 후 값 채우기 (.env.local 은 커밋되지 않음)
# Supabase 대시보드 → Project Settings → API
VITE_SUPABASE_URL=https://프로젝트ID.supabase.co
VITE_SUPABASE_ANON_KEY=anon_또는_publishable_키
# 토스페이먼츠 개발자센터 → API 키 → 테스트 "클라이언트" 키 (시크릿 키 아님!)
VITE_TOSS_CLIENT_KEY=test_ck_...
# 지도 (선택, #8 결정 후): 카카오디벨로퍼스 JavaScript 키. [JavaScript SDK 도메인]에 http://localhost:5173 등록
VITE_KAKAO_MAP_KEY=
